#!/usr/bin/env bash
# Sweep everything being pushed, COMMIT BY COMMIT.
#
# The obvious implementation is one sweep of remote..local, and it is wrong: that is
# a net diff, so a leak introduced in one commit and removed in a later one passes
# while `git show <sha>` still prints it. Measured here: the net diff was clean while
# two commits in the range each carried identifying data in their blobs.
set -uo pipefail
root="$(git rev-parse --show-toplevel)"; rc=0
while read -r _ lsha _ rsha; do
  case "$lsha" in *[!0]*) ;; *) continue ;; esac              # branch deletion
  case "$rsha" in *[!0]*) range="$rsha..$lsha" ;; *) range="$lsha" ;; esac
  for c in $(git rev-list "$range"); do
    parent=$(git rev-parse -q --verify "$c^" 2>/dev/null) || parent=""
    [ -n "$parent" ] || continue                              # root commit
    if ! out=$("$root/scripts/pii-sweep.sh" --range "$c^..$c" 2>&1); then
      echo "commit $(git log -1 --format='%h %s' "$c")" >&2
      printf '%s\n' "$out" >&2
      rc=1
    fi
  done
done
[ "$rc" -eq 0 ] && echo "pii-sweep: all commits in range clean"
exit $rc
