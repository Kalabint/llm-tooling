# Private values for the hooks. Copy to local.env, which is gitignored, and fill in.
# Every consumer treats an unset variable as "this check does not apply here", so a
# clone with no local.env runs with those branches inert rather than misfiring.
#
#   cp local.env.example local.env && $EDITOR local.env

# Mail domain the outbound guard protects. Unset: the guard passes everything.
KC_MAIL_DOMAIN=""

# Domain for minting throwaway addresses, offered in the block message.
KC_MINT_DOMAIN=""

# File host whose links can carry perf traces. Unset: that branch never fires.
KC_FILE_HOST=""

# LAN address of this machine, quoted when a loopback URL is handed to a remote
# user. Unset: the guard still fires, it just cannot name the address.
KC_LAN_IP=""

# Unix username, hunted by scripts/pii-sweep.sh. Unset: that class is skipped.
KC_USER_NAME=""
